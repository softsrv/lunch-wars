# Copy this file to .env and fill in real values. Never commit .env.

# Discord bot token, from the Bot tab of your application at
# https://discord.com/developers/applications
DISCORD_TOKEN=

# Postgres connection string.
DATABASE_URL=postgres://user:pass@localhost:5432/munchbot?sslmode=disable

# Optional: scope slash commands to a single guild for near-instant
# registration during development. Omit for global commands (which can take
# up to an hour to propagate to all servers).
DISCORD_GUILD_ID=
